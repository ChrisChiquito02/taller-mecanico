{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Creación y consulta del catálogo de roles",
    "subtitle": "Validación de entrada, duplicados, UUIDv7 y persistencia MySQL",
    "output": "diagramas/archify/flujo_roles.workflow.html",
    "quality_profile": "standard",
    "visual_preset": "blueprint"
  },
  "lanes": [
    {
      "id": "persona",
      "label": "Usuario autenticado"
    },
    {
      "id": "frontend",
      "label": "React · RolesFacade"
    },
    {
      "id": "backend",
      "label": "Spring Boot · API y Factory Method"
    },
    {
      "id": "mysql",
      "label": "MySQL · roles"
    }
  ],
  "phases": [
    {
      "id": "consulta",
      "label": "Consultar los roles existentes",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "crear",
      "label": "Validar y crear un rol",
      "fromCol": 2,
      "toCol": 5
    }
  ],
  "nodes": [
    {
      "id": "catalog_button",
      "lane": "persona",
      "col": 0,
      "type": "frontend",
      "label": "Abrir catálogo",
      "width": 150
    },
    {
      "id": "list_request",
      "lane": "frontend",
      "col": 1,
      "type": "backend",
      "label": "GET /roles",
      "width": 150
    },
    {
      "id": "list_query",
      "lane": "backend",
      "col": 2,
      "type": "backend",
      "label": "Ordenar por fecha",
      "width": 150
    },
    {
      "id": "list_select",
      "lane": "mysql",
      "col": 3,
      "type": "database",
      "label": "Leer roles",
      "width": 150
    },
    {
      "id": "modal",
      "lane": "frontend",
      "col": 4,
      "type": "frontend",
      "label": "Catálogo de roles",
      "width": 150
    },
    {
      "id": "name_input",
      "lane": "persona",
      "col": 1,
      "type": "frontend",
      "label": "Escribir rol",
      "width": 150
    },
    {
      "id": "regex_check",
      "lane": "frontend",
      "col": 2,
      "type": "security",
      "label": "Regex del nombre",
      "width": 150
    },
    {
      "id": "duplicate_request",
      "lane": "frontend",
      "col": 3,
      "type": "backend",
      "label": "GET /roles/exists",
      "width": 150
    },
    {
      "id": "duplicate_query",
      "lane": "mysql",
      "col": 4,
      "type": "database",
      "label": "Buscar duplicados",
      "width": 150
    },
    {
      "id": "factory",
      "lane": "backend",
      "col": 4,
      "type": "backend",
      "label": "Factory Method",
      "width": 150
    },
    {
      "id": "insert",
      "lane": "mysql",
      "col": 5,
      "type": "database",
      "label": "INSERT roles",
      "width": 150
    },
    {
      "id": "confirmation",
      "lane": "frontend",
      "col": 5,
      "type": "frontend",
      "label": "Resultado de creación",
      "width": 150
    }
  ],
  "edges": [
    {
      "from": "catalog_button",
      "to": "list_request",
      "label": "consultar",
      "role": "main"
    },
    {
      "from": "list_request",
      "to": "list_query",
      "role": "main"
    },
    {
      "from": "list_query",
      "to": "list_select",
      "role": "main"
    },
    {
      "from": "list_select",
      "to": "modal",
      "label": "lista ordenada",
      "role": "return"
    },
    {
      "from": "catalog_button",
      "to": "name_input",
      "label": "iniciar creación",
      "role": "branch"
    },
    {
      "from": "name_input",
      "to": "regex_check",
      "role": "main"
    },
    {
      "from": "regex_check",
      "to": "duplicate_request",
      "label": "formato válido",
      "role": "main"
    },
    {
      "from": "duplicate_request",
      "to": "duplicate_query",
      "role": "main"
    },
    {
      "from": "duplicate_query",
      "to": "confirmation",
      "label": "duplicado: no guardar",
      "role": "error"
    },
    {
      "from": "duplicate_query",
      "to": "factory",
      "label": "nombre disponible",
      "role": "main"
    },
    {
      "from": "factory",
      "to": "insert",
      "role": "main"
    },
    {
      "from": "insert",
      "to": "confirmation",
      "label": "persistencia confirmada",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "Validaciones",
      "items": [
        "Frontend usa regex antes de llamar la API",
        "Backend repite validación y evita duplicidad concurrente",
        "Los nombres duplicados no se crean aunque el rol esté suspendido"
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistencia",
      "items": [
        "Factory Method centraliza Role",
        "Suspender mantiene la fila en MySQL",
        "El modal permite consultar los roles registrados"
      ]
    }
  ]
}
